# Generate every credential independently, e.g. openssl rand -hex 32.
CONFHUB_IMAGE=confhub:dev
CONFHUB_DB_PASSWORD=REPLACE_DATABASE_PASSWORD
CONFHUB_ADMIN_PASSWORD=REPLACE_ADMIN_PASSWORD
CONFHUB_JWT_SECRET=REPLACE_JWT_SECRET_AT_LEAST_32_BYTES
CONFHUB_REPLICATION_TOKEN=REPLACE_SYNC_TOKEN_AT_LEAST_32_BYTES
CONFHUB_NATS_PASSWORD=REPLACE_NATS_PASSWORD
CONFHUB_REPLICATION_NETWORK=confhub-cloud-edge
CONFHUB_CLOUD_ALIAS=confhub-cloud
CONFHUB_NATS_ALIAS=confhub-nats
CONFHUB_REPLICATION_TRANSPORT=websocket
CONFHUB_CLOUD_REPLICATION_URL=
CONFHUB_EDGE_REPLICATION_URL=ws://confhub-cloud:8080/api/replication/watch
CONFHUB_REPLICATION_SUBJECT=confhub.replication
CONFHUB_REPLICATION_LEASE=30s
CONFHUB_EVENT_RETENTION=24h
CONFHUB_CLEANUP_INTERVAL=1m
CONFHUB_CLOUD_PORT=18080
CONFHUB_CLOUD_PORT2=18081
CONFHUB_EDGE_PORT=18090
CONFHUB_EDGE_PORT2=18091
CONFHUB_APP_CPUS=1.0
CONFHUB_APP_MEMORY=1g
CONFHUB_DB_CPUS=1.0
CONFHUB_DB_MEMORY=2g
