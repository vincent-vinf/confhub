# Copy to .env and replace the placeholder passwords and secret before starting.
# Use hexadecimal passwords to avoid reserved characters in the database DSN.
# Generate each value separately with: openssl rand -hex 32
CONFHUB_DB_PASSWORD=replaceWithRandomDatabasePassword
CONFHUB_ADMIN_PASSWORD=replaceWithRandomAdminPassword
CONFHUB_JWT_SECRET=replaceWithRandomSecretOfAtLeast32Bytes

# Only required by compose.mysql.yaml.
CONFHUB_DB_ROOT_PASSWORD=replaceWithRandomMySQLRootPassword

# Host ports; PORT2 and PORT3 are used by the ha profile.
CONFHUB_PORT=8080
CONFHUB_PORT2=8081
CONFHUB_PORT3=8082

# Application settings passed to every instance.
# Set COOKIE_SECURE=true when deploying behind HTTPS.
CONFHUB_COOKIE_SECURE=false
CONFHUB_JWT_EXPIRY=2h
CONFHUB_POLL_INTERVAL=100ms
CONFHUB_SYNC_FAILURE_TIMEOUT=2s
CONFHUB_CACHE_BYTES=67108864
CONFHUB_HISTORY_LIMIT=100
CONFHUB_CLEANUP_INTERVAL=1m
CONFHUB_EVENT_RETENTION=24h
